#include <stdio.h>
#include <stdlib.h>

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* beautifulArray(int n, int* returnSize) {
    *returnSize = n;
    int* result = (int*)malloc(n * sizeof(int));
    
    // Base case: an array of length 1 is always beautiful
    result[0] = 1;
    int currentSize = 1;

    // Keep expanding the beautiful array until it reaches or exceeds length n
    while (currentSize < n) {
        int* temp = (int*)malloc(n * sizeof(int));
        int idx = 0;

        // Step 1: Generate the odd elements (2 * x - 1)
        for (int i = 0; i < currentSize; i++) {
            int oddVal = 2 * result[i] - 1;
            if (oddVal <= n) {
                temp[idx++] = oddVal;
            }
        }

        // Step 2: Generate the even elements (2 * x)
        for (int i = 0; i < currentSize; i++) {
            int evenVal = 2 * result[i];
            if (evenVal <= n) {
                temp[idx++] = evenVal;
            }
        }

        // Update the current size and replace old results with expanded array
        currentSize = idx;
        free(result);
        result = temp;
    }

    return result;
}
