#include <stdlib.h>
#include <stdio.h>	
typedef struct Node
{
    int data;
    struct Node* next;
}Node;
Node* insert(Node *head, int data)
{
    // 1. Allocate memory for the new node
    Node* newNode = (Node*)malloc(sizeof(Node));
    newNode->data = data;
    newNode->next = NULL;

    // 2. If the list is empty, make the new node the head
    if (head == NULL) {
        return newNode;
    }

    // 3. Otherwise, traverse to the end of the list
    Node* current = head;
    while (current->next != NULL) {
        current = current->next;
    }

    // 4. Link the last node to the new node
    current->next = newNode;

    // 5. Return the unchanged head pointer
    return head;
}


void display(Node *head)
{
	Node *start=head;
	while(start)
	{
		printf("%d ",start->data);
		start=start->next;
	}
}
int main()
{
	int T,data;
    scanf("%d",&T);
    Node *head=NULL;	
    while(T-->0){
        scanf("%d",&data);
        head=insert(head,data);
    }
  display(head);
		
}
