int climbStairs(int n, int* costs, int costsSize) {
    int *dp = calloc(n+1,sizeof(int));
    
    for(int i=0;i<n+1;i++) dp[i] = INT_MAX;
    dp[0] = 0;
    for(int i=0;i<costsSize;i++){
        for(int j=i+1;j<=costsSize && j<=i+3;j++){
            dp[j] = fmin(dp[j],dp[i]+costs[j-1]+(j-i)*(j-i));
        }
    }
    return dp[n];
}
