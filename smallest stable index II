#define min(a,b) ((a)<(b) ? (a):(b));
#define max(a,b) ((a)>(b) ?(a):(b));
int firstStableIndex(int* nums, int numsSize, int k) {
   int* vt=(int*)malloc(numsSize*sizeof(int)); 
   int n=numsSize;
   int mini=INT_MAX;
        for(int i=n-1;i>=0;i--){
            mini=min(mini,nums[i]);
            vt[i]=mini;
        }
        int maxi=0;
        for(int i=0;i<n;i++){
            maxi=max(maxi,nums[i]);
            if((maxi-vt[i])<=k) return i;
        }
        return -1;
}
