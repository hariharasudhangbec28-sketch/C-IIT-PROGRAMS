#include <stdio.h>
#include <stdlib.h>

#define MOD 1000000007

int waysToReachTarget(int target, int** types, int typesSize, int* typesColSize) {
    // Allocate memory for tracking combinations for each score from 0 up to target
    int* dp = (int*)calloc(target + 1, sizeof(int));
    
    // Base case: There is 1 way to earn exactly 0 points (by solving 0 questions)
    dp[0] = 1;
    
    // Iterate through each question type
    for (int i = 0; i < typesSize; i++) {
        int count = types[i][0];
        int marks = types[i][1];
        
        // Loop backward from target to 1 to prevent using the same type's questions twice
        for (int j = target; j >= 1; j--) {
            // Try solving k questions of the current type (from 1 up to count)
            for (int k = 1; k <= count; k++) {
                int total_marks_gained = k * marks;
                
                if (j >= total_marks_gained) {
                    dp[j] = (dp[j] + dp[j - total_marks_gained]) % MOD;
                } else {
                    break; // If k questions exceed score j, larger k values will too
                }
            }
        }
    }
    
    int result = dp[target];
    free(dp); // Clean up dynamically allocated array memory
    
    return result;
}
