#include <stdio.h>
#include <stdlib.h>
#include <math.h>

int minTimeToVisitAllPoints(int** points, int pointsSize, int* pointsColSize) {
    // Base case: If there are fewer than 2 points, no travel time is required
    if (pointsSize <= 1) {
        return 0;
    }
    
    int total_time = 0;
    
    // Iterate through the array and sum distances between consecutive points
    for (int i = 0; i < pointsSize - 1; i++) {
        int x_diff = abs(points[i+1][0] - points[i][0]);
        int y_diff = abs(points[i+1][1] - points[i][1]);
        
        // Chebyshev distance calculation
        if (x_diff > y_diff) {
            total_time += x_diff;
        } else {
            total_time += y_diff;
        }
    }
    
    return total_time;
}
