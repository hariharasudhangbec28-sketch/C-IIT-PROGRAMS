#include <stdio.h>
#include <stdlib.h>

// Comparator function to sort points by their X-coordinate in ascending order
int comparePoints(const void* a, const void* b) {
    int x1 = (*(int**)a)[0];
    int x2 = (*(int**)b)[0];
    return (x1 > x2) - (x1 < x2);
}

int maxWidthOfVerticalArea(int** points, int pointsSize, int* pointsColSize) {
    if (pointsSize < 2) {
        return 0;
    }
    
    // Step 1: Sort the points based on their X-coordinates
    qsort(points, pointsSize, sizeof(int*), comparePoints);
    
    int max_width = 0;
    
    // Step 2: Calculate the maximum difference between adjacent X-coordinates
    for (int i = 0; i < pointsSize - 1; i++) {
        int width = points[i+1][0] - points[i][0];
        if (width > max_width) {
            max_width = width;
        }
    }
    
    return max_width;
}
