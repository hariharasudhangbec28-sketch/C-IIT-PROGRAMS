#include <stdio.h>
#include <stdlib.h>

/**
 * Return an array of size *returnSize.
 * Note: The returned array must be MALLOCED, not returned from a local variable.
 */
int* countPoints(int** points, int pointsSize, int* pointsColSize, int** queries, int queriesSize, int* queriesColSize, int* returnSize) {
    // Allocate memory for the results array matching the number of queries
    int* answer = (int*)malloc(queriesSize * sizeof(int));
    
    // Iterate through each query circle
    for (int j = 0; j < queriesSize; j++) {
        int qx = queries[j][0];
        int qy = queries[j][1];
        long long qr = queries[j][2];
        long long qr_squared = qr * qr; // R^2 factor
        
        int points_inside_count = 0;
        
        // Check this query against all given coordinates
        for (int i = 0; i < pointsSize; i++) {
            long long dx = points[i][0] - qx;
            long long dy = points[i][1] - qy;
            
            // Check the coordinate using the squared distance inequality
            if (dx * dx + dy * dy <= qr_squared) {
                points_inside_count++;
            }
        }
        
        answer[j] = points_inside_count;
    }
    
    *returnSize = queriesSize;
    return answer;
}
