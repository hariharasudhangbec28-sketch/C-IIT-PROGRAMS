#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* longestCommonPrefix(char** strs, int strsSize) {
    // If the input array is empty, return a newly allocated empty string
    if (strsSize == 0) {
        char* empty = (char*)malloc(sizeof(char));
        empty[0] = '\0';
        return empty;
    }

    // Use the first string as a reference benchmark
    char* benchmark = strs[0];
    int len = 0;

    // Traverse character by character through the benchmark string
    while (benchmark[len] != '\0') {
        // Compare this character with the same index of all other strings
        for (int i = 1; i < strsSize; i++) {
            // Stop if the current string ends or a mismatch is detected
            if (strs[i][len] == '\0' || strs[i][len] != benchmark[len]) {
                goto end_search;
            }
        }
        len++;
    }

end_search:;
    // Allocate exact memory for the prefix result + null terminator
    char* result = (char*)malloc((len + 1) * sizeof(char));
    strncpy(result, benchmark, len);
    result[len] = '\0'; // Explicitly add null terminator

    return result;
}
